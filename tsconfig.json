{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2020", "DOM"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": false,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["blockbench-types"]
	},
	"include": ["src/**/*"]
}
